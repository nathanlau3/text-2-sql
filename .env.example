# Salin file ini menjadi .env lalu isi nilainya.  (cp .env.example .env)
# Di Streamlit Cloud, isi nilai yang sama di menu: App settings -> Secrets.

OPENAI_API_KEY=sk-...

# Format "<provider>:<model>" untuk langchain.init_chat_model.
# gpt-6-luna = model termurah OpenAI yang belum deprecated.
LLM_MODEL=openai:gpt-6-luna

# none | low | medium | high. "low" = murah & cepat; naikkan ke "medium" kalau
# SQL untuk pertanyaan sulit sering salah. Kosongkan untuk model non-reasoning.
LLM_REASONING_EFFORT=low

# Batas self-correction loop (soal minta minimal 2x retry).
MAX_SQL_RETRIES=3
MAX_RESULT_ROWS=200
QUERY_TIMEOUT_SECONDS=5

# Opsional: kunci tanggal "hari ini" agar jawaban pertanyaan relatif
# (mis. "DueDate < HARI INI") deterministik saat testing. Format YYYY-MM-DD.
# TODAY_OVERRIDE=2026-11-07
